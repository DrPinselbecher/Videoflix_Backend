# Django
SECRET_KEY=replace_this_with_a_generated_secret_key
DEBUG=False

ALLOWED_HOSTS=your-api-domain.example.com
CSRF_TRUSTED_ORIGINS=https://your-api-domain.example.com,https://your-frontend-domain.example.com,https://www.your-frontend-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com,https://www.your-frontend-domain.example.com
CORS_ALLOW_CREDENTIALS=True

FRONTEND_BASE_URL=https://your-frontend-domain.example.com
EMAIL_LOGO_URL=https://your-public-logo-url.example.com/videoflix_logo.png

# Cookies / HTTPS
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax
CSRF_COOKIE_DOMAIN=.your-root-domain.example.com
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Initial Django superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace_this_with_a_secure_admin_password
DJANGO_SUPERUSER_EMAIL=admin@example.com

# PostgreSQL
DB_NAME=videoflix_db
DB_USER=videoflix_user
DB_PASSWORD=replace_this_with_a_secure_database_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

# E-Mail / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=your_mailbox@example.com
EMAIL_HOST_PASSWORD=replace_this_with_your_mailbox_password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=Videoflix <your_mailbox@example.com>